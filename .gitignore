# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 模型与数据（体积大，不入库；锚定到根目录，避免误伤 minigpt/data 代码包）
*.pth
*.bin
*.pt
checkpoint-*/
/models/
# 注意：必须写成 /dataset/*（忽略内容）而不是 /dataset/（忽略目录本身）——
# git 不会进入被忽略的目录，写目录形式时下面的否定规则不生效
/dataset/*
# 例外：dataset/README.md 是文档（各阶段数据源说明），不是数据，应该进版本库
!/dataset/README.md
/data/

# 日志
*.log
nohup.out

# 系统 / 编辑器
.DS_Store
.idea/
.vscode/
